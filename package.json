{
  "name": "yardhand",
  "version": "0.1.1",
  "description": "File-based issue tracking for repos worked on by people and AI models.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanlhuber/yardhand.git"
  },
  "homepage": "https://github.com/ryanlhuber/yardhand#readme",
  "bugs": {
    "url": "https://github.com/ryanlhuber/yardhand/issues"
  },
  "type": "module",
  "bin": {
    "yardhand": "dist/cli.js"
  },
  "files": [
    "dist",
    "SPEC.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsup && node --test dist-test/*.test.js",
    "check": "npm run typecheck && npm test"
  },
  "license": "MIT",
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0"
  }
}
