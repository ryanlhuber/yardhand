{
  "name": "lolo",
  "version": "0.1.0",
  "description": "File-based issue tracking for repos worked on by people and AI models.",
  "type": "module",
  "bin": {
    "lolo": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsup && node --test \"dist-test/*.test.js\"",
    "check": "npm run typecheck && npm test"
  },
  "license": "MIT",
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0"
  }
}
